CREATE TABLE todos(
id SERIAL PRIMARY KEY,
title VARCHAR(225) NOT NULL,
body TEXT NOT NULL,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
done BOOLEAN DEFAULT FALSE
);

